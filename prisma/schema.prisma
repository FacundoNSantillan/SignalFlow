generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Notification {
  id        String             @id @default(uuid())
  type      String
  recipient String
  subject   String?
  body      String
  status    NotificationStatus @default(PENDING)
  jobId     String?
  error     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

enum NotificationStatus {
  PENDING
  COMPLETED
  FAILED
}
